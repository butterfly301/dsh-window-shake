{
  "name": "dsh-window-shake",
  "version": "0.2.0",
  "type": "module",
  "description": "Detects vigorous horizontal desktop window shaking at 20 Hz and broadcasts a decoupled dsh:window-shake event.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/butterfly301/dsh-window-shake.git"
  },
  "homepage": "https://github.com/butterfly301/dsh-window-shake#readme",
  "bugs": {
    "url": "https://github.com/butterfly301/dsh-window-shake/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "window-shake",
    "easter-egg"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.2-rc.5 <0.3.0"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "node --test \"test/*.test.js\""
  },
  "files": [
    "cordis.patch.yml",
    "index.js",
    "client.js",
    "locale",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
